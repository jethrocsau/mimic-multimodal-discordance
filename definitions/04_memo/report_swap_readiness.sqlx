config {
  type: "view",
  tags: ["memo"],
  description: "Table C-S3 roll-up: share of the all-5-modality set in each swap-readiness grade, per cohort level."
}

SELECT
  level_id,
  cohort_level,
  swap_readiness,
  COUNT(*)        AS n_strata,
  SUM(all5_n)     AS patients,
  SUM(all5_died)  AS died,
  SUM(all5_alive) AS alive,
  ROUND(100 * SAFE_DIVIDE(SUM(all5_n), SUM(SUM(all5_n)) OVER (PARTITION BY level_id)), 1) AS pct_of_all5_set
FROM ${ref("t_table_c_s3_strata")}
GROUP BY level_id, cohort_level, swap_readiness
